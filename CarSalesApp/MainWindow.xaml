<Window x:Class="CarSalesApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarSalesApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="xmlGrid" Margin="0,0,0,189" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Název modelu" Binding="{Binding Model}"/>
                <DataGridTextColumn Header="Cena bez DPH" Binding="{Binding PriceWithoutVAT}"/>
                <DataGridTextColumn Header="Cena s DPH" Binding="{Binding PriceWithVAT}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="button" Content="Button" HorizontalAlignment="Center" Margin="0,312,0,0" VerticalAlignment="Top" Click="loadXml_click"/>
    </Grid>
</Window>
